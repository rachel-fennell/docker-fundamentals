FROM nginx:1.29-alpine
COPY index.html /usr/share/nginx/html/index.html
RUN apk add --no-cache curl
LABEL org.opencontainers.image.source="https://github.com/rachel-fennell/docker-fundamentals"
EXPOSE 80


